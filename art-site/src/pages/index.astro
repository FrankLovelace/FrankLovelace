---
import MainLayout from '../layouts/MainLayout.astro';
//imagenes random xd
const cards = [
    {
        name: "Harry Thorne",
        caste: "Súpertocado",
        lema: "«Sonríe»",
        description: "Academia de Arte de Vornia",
        img: "/H.png",
        href: "/personajes?personaje=harry-thorne#harry-thorne",
    },
    {
        name: "Aqua Reyes",
        caste: "Súpertocado",
        lema: "«Solo podemos aspirar a ser mejores»",
        description: "Egresado del Edén",
        img: "/Aq.png",
        href: "/personajes?personaje=aqua-reyes#aqua-reyes",
    },
    {
        name: "Diana Belmont",
        caste: "Súpertocado",
        lema: "«No podemos controlar lo que somos, solo lo que hacemos con ello»",
        description: "Familia Belmont",
        img: "/diana.png",
        href: "/personajes?personaje=diana-belmont#diana-belmont",
    },
    {
        name: "Alexa Thorne",
        caste: "Súpertocada",
        lema: "«Nunca te avergüences de quién eres»",
        description: "The Hormenia Times · Periodismo",
        img: "/Al.png",
        href: "/personajes?personaje=alexa-thorne#alexa-thorne",
    }
];
---

<MainLayout>

    <section class="text-center py-20 px-6">
        <h1 class="text-5xl md:text-6xl font-normal text-gray-900 mb-4 tracking-tight">
            Los jóvenes del futuro
        </h1>
        <div class="w-16 h-1 bg-gradient-to-r from-blue-500 to-cyan-400 mx-auto rounded-full mb-6"></div>
        <p class="text-lg text-gray-500 max-w-2xl mx-auto">
            Descubre a los herederos que llevarán a Hormenia hacia una nueva era de luz y progreso. 
        </p>
    </section>

    <section class="w-full px-4 pb-20 max-w-[1600px] mx-auto">
        <div class="flex flex-col md:flex-row gap-3 h-[620px] w-full">
            
            {cards.map((card) => (
                <a 
                    href={card.href}
                    class="relative flex-1 hover:flex-[3] transition-all duration-700 ease-in-out cursor-pointer group overflow-hidden rounded-3xl block shadow-sm hover:shadow-2xl"
                >
                    
                    <!-- Imagen -->
                    <img 
                        src={card.img} 
                        alt={card.name}
                        class="absolute inset-0 w-full h-full object-cover filter brightness-[0.85] group-hover:brightness-100 transition-all duration-700 group-hover:scale-105"
                    />
                    
                    <!-- Overlay de gradiente -->
                    <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/25 to-transparent opacity-75 group-hover:opacity-90 transition-opacity"></div>

                    <!-- Contenido de la Tarjeta -->
                    <div class="absolute bottom-0 left-0 w-full p-8 translate-y-2 group-hover:translate-y-0 transition-transform duration-500">
                        <span class="text-xs font-bold uppercase tracking-wider text-blue-400 block mb-1 drop-shadow-sm">
                            {card.description}
                        </span>
                        <h2 class="text-3xl md:text-4xl font-bold text-white mb-2 drop-shadow-md leading-tight">{card.name}</h2>
                        <div class="max-h-0 group-hover:max-h-48 overflow-hidden transition-all duration-700">
                            <p class="text-base text-gray-200 font-serif italic mb-4 drop-shadow">
                                {card.lema}
                            </p>
                            <span class="inline-flex items-center gap-2 text-xs bg-white text-black px-4 py-2.5 rounded-full font-bold uppercase tracking-wider hover:bg-blue-50 transition-all shadow-md">
                                Conocer personaje
                                <svg class="w-3.5 h-3.5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                            </span>
                        </div>
                    </div>
                </a>
            ))}

        </div>
    </section>

</MainLayout>