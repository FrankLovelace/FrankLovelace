---
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const levels = dict.nav.levels;
const digits = '0123456789'.split('');
const last = levels.length - 1;
---

<div class="hud">
  <div class="mag-slider" data-mag-slider data-interactive>
    <span class="mag-slider__label" aria-hidden="true">{dict.hud.magnification}</span>
    <div
      class="mag-slider__track"
      data-mag-track
      role="slider"
      tabindex="0"
      aria-label={dict.hud.sliderLabel}
      aria-valuemin="0"
      aria-valuemax={last}
      aria-valuenow="0"
      aria-valuetext={`1× · ${levels[0]}`}
    >
      {levels.map((_, i) => <span class="mag-slider__tick" style={`--at: ${i / last}`} aria-hidden="true" />)}
      <span class="mag-slider__knob" aria-hidden="true"></span>
    </div>
    <span class="mag-slider__value" data-mag-readout title={dict.hud.scrubHint} aria-hidden="true">1×</span>
  </div>
  <div class="hud__scale" aria-hidden="true">
    <div class="hud__bar"></div>
    <div data-bar-label>10 cm</div>
  </div>
  <div class="hud__lens" data-lens-label aria-hidden="true">{levels[0]}</div>
</div>

<nav aria-label="Levels">
  <ul class="levels">
    {
      levels.map((label, i) => (
        <li>
          <a href={`#level-${i}`} data-level-link={i} aria-current={i === 0 ? 'true' : undefined}>
            <span class="dot" aria-hidden="true" />
            <span class="label">{label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<!-- scroll ruler (after getartcraft.com): built by src/scripts/ruler.ts, only with a fine pointer -->
<div
  class="ruler"
  data-ruler-rail
  role="scrollbar"
  aria-controls="main"
  aria-orientation="vertical"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
  aria-label={dict.ruler.label}
  data-jump-label={dict.ruler.jump}
  data-interactive
  hidden
>
  <div class="ruler__frost" aria-hidden="true"></div>
  <div class="ruler__ticks" data-ruler-ticks aria-hidden="true"></div>
  <div class="ruler__bracket" data-ruler-bracket aria-hidden="true"></div>
  <div class="ruler__needle" data-ruler-needle aria-hidden="true">
    <span class="ruler__needle-line"></span>
    <span class="ruler__readout" data-ruler-readout>
      <span class="ruler-digits">
        {[0, 1, 2].map(() => <span class="ruler-digit-col">{digits.map((d) => <span>{d}</span>)}</span>)}
      </span><span class="ruler__pct">%</span>
    </span>
  </div>
  <div class="ruler__ghost" data-ruler-ghost aria-hidden="true"></div>
</div>
<div class="ruler-words" data-ruler-words hidden></div>
